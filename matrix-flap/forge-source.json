    "appFiles": {
      "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover, user-scalable=no\">\n<meta name=\"theme-color\" content=\"#040610\">\n<title>Matrix Flap — Neon Flight</title>\n<style>\n:root{color-scheme:dark;--lime:#72ff97;--green:#00eb74;--purple:#b467ff;--violet:#813cf7;--ink:#040610}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nhtml,body{width:100%;height:100%;margin:0;overflow:hidden;background:#040610;color:#ccffda;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif}\nbody{touch-action:none;user-select:none;-webkit-user-select:none}\n#game{position:relative;height:100vh;height:100dvh;width:100vw;overflow:hidden;isolation:isolate;background:radial-gradient(ellipse at 45% 28%,#08182c 0%,#060917 40%,#040610 100%)}\ncanvas{display:block;width:100%;height:100%;touch-action:none}\n.top{position:absolute;left:0;top:0;width:100%;z-index:2;display:flex;align-items:flex-start;justify-content:space-between;padding:calc(env(safe-area-inset-top,0px) + 21px) 20px 0;pointer-events:none}\n.brand{line-height:1}.label{font-size:9px;letter-spacing:4px;color:#b77cf1;font-weight:800;text-shadow:0 0 12px #914fff70}\n.brand strong{display:block;margin-top:7px;font-family:ui-monospace,Consolas,monospace;font-size:clamp(21px,5.9vw,30px);letter-spacing:3px;font-weight:900;color:#7cff9f;text-shadow:0 0 9px #00ee75aa,0 0 25px #00ee7555}\n.brand strong span{color:#bc74ff;text-shadow:0 0 15px #a44affaa}\n.stats{display:flex;gap:11px;text-align:center}.stat{min-width:59px;padding:7px 9px 8px;border:1px solid #31664688;border-radius:10px;background:linear-gradient(145deg,#091e18c9,#0b101ec9);box-shadow:inset 0 0 14px #00e66e0b,0 0 13px #00ff660e}\n.stat small{display:block;color:#9f92b6;font-size:9px;letter-spacing:1.5px;font-weight:800}.stat b{display:block;margin-top:2px;color:#adffbc;font-family:ui-monospace,Consolas,monospace;font-size:23px;line-height:1.08}\n.stat.best{border-color:#663c7e88}.stat.best b{color:#c88cff}\n#sheet{position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center;pointer-events:none;padding:90px 25px 86px}\n#sheet.hidden{display:none}\n.card{width:min(100%,365px);padding:28px 25px 25px;border-radius:18px;border:1px solid #63ff9280;background:linear-gradient(160deg,rgba(6,23,25,.94),rgba(10,7,26,.95));box-shadow:0 0 0 5px #00ff6508,inset 0 0 36px #08ff7820,0 0 36px #43e89518;text-align:center;backdrop-filter:blur(9px);pointer-events:auto}\n.emblem{width:66px;height:66px;margin:0 auto 14px;display:grid;place-items:center;border:2px solid #8aff9e;border-radius:50%;background:#072518;box-shadow:0 0 25px #44ff8355,inset 0 0 25px #29ff4125;font-family:ui-monospace,Consolas,monospace;color:#98ffab;font-size:31px;transform:rotate(-9deg)}\n.kicker{color:#ae6fff;font-weight:800;letter-spacing:3.7px;font-size:10px}\n.card h1{font-size:clamp(25px,7vw,37px);font-family:ui-monospace,Consolas,monospace;line-height:1.1;margin:9px 0 14px;letter-spacing:2px;color:#79ffa3;text-shadow:0 0 17px #37ff8c88}\n.card p{font-size:14px;line-height:1.55;margin:0 auto 22px;max-width:265px;color:#a5bbae}\nbutton{display:block;width:100%;min-height:55px;border-radius:9px;border:1px solid #95ffb0;color:#02130b;background:linear-gradient(115deg,#62ff8c,#26e884);box-shadow:0 5px 24px #00ff7663,inset 0 1px 0 #e5ffeb;font-size:15px;font-weight:900;letter-spacing:2px;font-family:ui-monospace,Consolas,monospace;cursor:pointer;touch-action:manipulation}\nbutton:active{filter:brightness(.82);transform:translateY(1px)}\n.detail{margin-top:15px;color:#ad83d9;font-size:10px;font-weight:700;letter-spacing:1.5px}\n#scoreline{display:none;color:#d3c0ef;margin:0 0 15px;font-size:14px}#scoreline b{font-size:26px;color:#adffba}\n.bottom{position:absolute;bottom:calc(env(safe-area-inset-bottom,0px) + 15px);left:0;width:100%;z-index:2;color:#6cd9a48c;display:flex;justify-content:space-between;padding:0 21px;font:700 9px ui-monospace,Consolas,monospace;letter-spacing:1.8px;pointer-events:none}\n#flash{position:absolute;inset:0;pointer-events:none;background:#ff2875;opacity:0;z-index:4;transition:opacity .13s}\n@media(max-height:575px){.top{padding-top:10px}.brand strong{font-size:18px}.card{padding:15px}.emblem{width:45px;height:45px;margin-bottom:7px;font-size:24px}.card h1{font-size:26px;margin:7px 0}.card p{margin-bottom:13px}.bottom{bottom:8px}}\n\n\n/* V1.1: refined cockpit HUD and touch-first controls */\n.top{padding:calc(env(safe-area-inset-top,0px) + 19px) 16px 0;align-items:flex-start}\n.brand strong{font-size:clamp(20px,5.6vw,28px)}\n.stats{gap:7px}.stat{min-width:53px;padding:7px 8px}.stat b{font-size:22px}\n.hud-status.hidden{display:none}\n.hud-status{position:absolute;top:calc(env(safe-area-inset-top,0px) + 83px);left:17px;z-index:2;font:800 9px ui-monospace,monospace;color:#70deac;letter-spacing:2px;text-shadow:0 0 10px #22ff8877;pointer-events:none}\n.tools{position:absolute;right:17px;top:calc(env(safe-area-inset-top,0px) + 84px);z-index:5;display:flex;gap:9px}\n.tool{width:46px;min-height:44px;height:44px;border-radius:13px;background:linear-gradient(145deg,#10251eec,#110c27ed);border:1px solid #589d81a8;color:#b8ffce;font-size:23px;letter-spacing:0;box-shadow:0 0 15px #39ff7514;display:flex;align-items:center;justify-content:center;padding:0}\n.tool.purple{border-color:#8752ca;color:#dbb1ff}.tool.hidden{display:none}\n.fps{position:absolute;right:19px;top:calc(env(safe-area-inset-top,0px) + 137px);z-index:3;font:700 10px ui-monospace,monospace;letter-spacing:2px;color:#a5ffbe;background:#06131dc9;border-radius:6px;padding:3px 7px;pointer-events:none}\n.fps.hidden{display:none}\n.modal{backdrop-filter:none;position:absolute;inset:0;display:grid;place-items:center;z-index:7;padding:88px 18px 76px;background:linear-gradient(180deg,#020813c5,#030a1de8);backdrop-filter:blur(6px)}\n.modal.hidden{display:none}.modal .card{width:min(100%,350px);max-height:min(83dvh,660px);overflow-y:auto}\n.card{backdrop-filter:none;border-radius:21px;border-color:#6cffaaa0;box-shadow:0 0 0 1px #d3f8ff19,inset 0 0 44px #08ff7815,0 18px 55px #000b18cf,0 0 42px #3df9991a}\n.card:before{content:'◈  TRION / FLIGHT SYSTEM';display:block;color:#77ffb299;letter-spacing:2px;font:700 8px ui-monospace,monospace;margin:-4px 0 15px}\n.card h1{letter-spacing:2.5px}\n.card button{min-height:53px}\n.minor{margin-top:12px;background:linear-gradient(120deg,#16142d,#111c28);border:1px solid #9879c6;color:#d4b3ff;box-shadow:inset 0 0 18px #bb78ff11;font-size:12px}\n.option-row{display:flex;align-items:center;justify-content:space-between;gap:13px;padding:11px 0;border-top:1px solid #315a4b77;text-align:left;color:#bfe9d0;font:700 13px ui-monospace,monospace}\n.option-row button{width:95px;min-height:43px;font-size:12px;letter-spacing:1px;flex-shrink:0}\n.option-row button[aria-pressed=\"false\"]{border-color:#5d517d;background:linear-gradient(125deg,#242137,#17182c);color:#ad94c7;box-shadow:none}\n.panel-note{font-size:11px;color:#8faeae;line-height:1.5;margin:5px auto 18px}\n.pill{display:inline-block;border:1px solid #4f8e76;border-radius:99px;background:#031e19c0;color:#83ffae;padding:6px 12px;font:800 10px ui-monospace,monospace;letter-spacing:1px;margin-bottom:14px}\n#sheet .card{position:relative;overflow:hidden}\n#sheet .card:after{content:'';position:absolute;top:0;left:20%;width:60%;height:1px;background:linear-gradient(90deg,transparent,#a6ffcf,transparent);box-shadow:0 0 15px 2px #45ff9b55}\n#sheet .emblem{width:72px;height:72px;box-shadow:0 0 0 8px #28fe8c0c,0 0 28px #42ff8b77,inset 0 0 25px #24ff4b32}\n#sheet .detail{line-height:1.6}\n#sheet .card{max-height:calc(100dvh - 110px);overflow-y:auto}\n#sheet p{max-width:285px}\n.bottom{font-size:9px;bottom:calc(env(safe-area-inset-bottom,0px) + 13px)}\n@media(max-width:340px){.top{padding-inline:10px}.brand strong{font-size:18px;letter-spacing:1px}.stats{gap:4px}.stat{min-width:45px;padding:6px}.stat b{font-size:19px}.label{letter-spacing:2px}.hud-status{left:11px}}\n@media(max-height:590px){.hud-status{top:65px}.tools{top:64px}.fps{top:115px}.modal{padding:45px 12px}.card{padding:17px}.card:before{display:none}}\n@media(prefers-reduced-motion:reduce){.card,button{scroll-behavior:auto}}\n</style>\n</head>\n<body>\n<div id=\"game\">\n  <canvas id=\"board\" aria-label=\"Matrix Flap game area\"></canvas>\n  <header class=\"top\">\n    <div class=\"brand\"><div class=\"label\">TRION // ARCADE</div><strong>MATRIX<span>FLAP</span></strong></div>\n    <div class=\"stats\"><div class=\"stat\"><small>SCORE</small><b id=\"score\">00</b></div><div class=\"stat best\"><small>BEST</small><b id=\"best\">00</b></div></div>\n  </header>\n  <div class=\"hud-status\" id=\"hudStatus\">● SIGNAL STABLE // STANDBY</div>\n  <div class=\"tools\"><button id=\"pauseBtn\" class=\"tool hidden\" type=\"button\" aria-label=\"Pause game\">Ⅱ</button><button id=\"settingsBtn\" class=\"tool purple\" type=\"button\" aria-label=\"Open settings\">⚙</button></div>\n  <div id=\"fps\" class=\"fps hidden\" aria-label=\"Frames per second\">60 FPS</div>\n  <section id=\"sheet\" aria-live=\"polite\"><div class=\"card\">\n    <div class=\"emblem\" id=\"emblem\">⟡</div><div class=\"kicker\" id=\"kicker\">SYSTEM ONLINE</div>\n    <h1 id=\"message\">NEON FLIGHT</h1>\n    <p id=\"helper\">Tap to flap. Navigate between the purple gates. How far can you get?</p>\n    <div id=\"scoreline\">FINAL SCORE <b id=\"finalscore\">0</b></div>\n    <button id=\"action\" type=\"button\">▶ INITIALIZE RUN</button>\n    <div class=\"detail\" id=\"subtext\">TAP SCREEN OR PRESS SPACE TO FLY</div>\n    <button class=\"minor\" id=\"menuSettings\" type=\"button\">⚙ FLIGHT SETTINGS</button>\n  </div></section>\n  <section class=\"modal hidden\" id=\"settingsSheet\" aria-label=\"Flight settings\" role=\"dialog\" aria-modal=\"true\"><div class=\"card\">\n    <div class=\"pill\">PERSONALIZE YOUR RUN</div><h1>FLIGHT SETTINGS</h1>\n    <p class=\"panel-note\">Adjust feedback and graphics. Your choices are saved on this device.</p>\n    <div class=\"option-row\"><span>SOUND EFFECTS</span><button id=\"toggleSound\" type=\"button\" aria-label=\"Sound effects\" aria-pressed=\"false\">OFF</button></div>\n    <div class=\"option-row\"><span>PARTICLE EFFECTS</span><button id=\"toggleEffects\" type=\"button\" aria-label=\"Particle effects\" aria-pressed=\"true\">ON</button></div>\n    <div class=\"option-row\"><span>FPS COUNTER</span><button id=\"toggleFps\" type=\"button\" aria-label=\"FPS counter\" aria-pressed=\"false\">OFF</button></div>\n    <div class=\"option-row\"><span>HAPTIC FEEDBACK</span><button id=\"toggleHaptics\" type=\"button\" aria-label=\"Haptic feedback\" aria-pressed=\"true\">ON</button></div>\n    <button id=\"closeSettings\" class=\"minor\" type=\"button\">← BACK TO FLIGHT</button>\n  </div></section>\n  <section class=\"modal hidden\" id=\"pauseSheet\" aria-label=\"Paused game\" role=\"dialog\" aria-modal=\"true\"><div class=\"card\">\n    <div class=\"pill\">FLIGHT TELEMETRY PAUSED</div><h1>MISSION PAUSED</h1>\n    <p>Your flight is safely suspended. Continue when you're ready.</p>\n    <button id=\"resumeBtn\" type=\"button\">▶ RESUME FLIGHT</button>\n    <button id=\"restartBtn\" class=\"minor\" type=\"button\">↻ RESTART RUN</button>\n    <button id=\"homeBtn\" class=\"minor\" type=\"button\">⌂ MAIN MENU</button>\n  </div></section>\n  <footer class=\"bottom\"><span>OFFLINE // V1.1</span><span>TRION • NEON FLIGHT</span></footer>\n  <div id=\"flash\"></div>\n</div>\n<script>\n(()=>{'use strict';\nconst canvas=document.getElementById('board'),ctx=canvas.getContext('2d');\nconst scoreEl=document.getElementById('score'),bestEl=document.getElementById('best');\nconst sheet=document.getElementById('sheet'),action=document.getElementById('action');\nconst message=document.getElementById('message'),helper=document.getElementById('helper');\nconst kicker=document.getElementById('kicker'),subtext=document.getElementById('subtext');\nconst finalscore=document.getElementById('finalscore'),scoreline=document.getElementById('scoreline');\nconst flash=document.getElementById('flash');\nconst pauseBtn=document.getElementById('pauseBtn'),settingsBtn=document.getElementById('settingsBtn');\nconst menuSettings=document.getElementById('menuSettings'),settingsSheet=document.getElementById('settingsSheet');\nconst pauseSheet=document.getElementById('pauseSheet'),hudStatus=document.getElementById('hudStatus');\nconst fpsEl=document.getElementById('fps');\nconst settingsButtons={sound:document.getElementById('toggleSound'),effects:document.getElementById('toggleEffects'),fps:document.getElementById('toggleFps'),haptics:document.getElementById('toggleHaptics')};\nconst settings={sound:false,effects:true,fps:false,haptics:true};\ntry{Object.assign(settings,JSON.parse(localStorage.getItem('matrixFlapSettings')||'{}'))}catch(_){}\nlet overlay='none',averageFps=60,fpsSamples=0,fpsAccumulator=0,runSeconds=0,passes=0;\nlet perfQuality=1.1,lowFpsWindows=0;\nlet audioContext=null,shipPulse=0,viewTime=0;\nconst reduceMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;\nfunction playTone(frequency=440,duration=.065,kind='sine',volume=.06){\n if(!settings.sound)return;\n try{audioContext=audioContext||new (window.AudioContext||window.webkitAudioContext)();\n  if(audioContext.state==='suspended')audioContext.resume();\n  const oscillator=audioContext.createOscillator(),gain=audioContext.createGain(),now=audioContext.currentTime;\n  oscillator.type=kind;oscillator.frequency.setValueAtTime(frequency,now);\n  oscillator.frequency.exponentialRampToValueAtTime(Math.max(100,frequency*.8),now+duration);\n  gain.gain.setValueAtTime(volume,now);gain.gain.exponentialRampToValueAtTime(.001,now+duration);\n  oscillator.connect(gain).connect(audioContext.destination);oscillator.start(now);oscillator.stop(now+duration);\n }catch(_){}\n}\nfunction vibrate(ms){if(settings.haptics&&navigator.vibrate)try{navigator.vibrate(ms)}catch(_){}}\nfunction syncSettings(){\n for(const [key,button] of Object.entries(settingsButtons)){\n  button.textContent=settings[key]?'ON':'OFF';button.setAttribute('aria-pressed',String(!!settings[key]));\n }\n fpsEl.classList.toggle('hidden',!settings.fps);\n try{localStorage.setItem('matrixFlapSettings',JSON.stringify(settings))}catch(_){}\n}\nfunction updateHud(){\n pauseBtn.classList.toggle('hidden',mode!=='playing');\n settingsBtn.classList.toggle('hidden',mode==='ready'||mode==='over');\n hudStatus.classList.toggle('hidden',mode==='ready'||mode==='over');\n hudStatus.textContent=mode==='playing'?'● RUNNING // GATE '+String(score+1).padStart(2,'0'):\n  mode==='paused'?'◉ SYSTEM PAUSED':mode==='over'?'× SIGNAL LOST':'● SIGNAL STABLE // STANDBY';\n}\nfunction pause(){if(mode!=='playing')return;mode='paused';overlay='pause';pauseSheet.classList.remove('hidden');updateHud();playTone(320,.09)}\nfunction resume(){if(mode!=='paused')return;mode='playing';overlay='none';pauseSheet.classList.add('hidden');last=0;updateHud();playTone(540,.08)}\nfunction home(){mode='ready';overlay='none';settingsSheet.classList.add('hidden');pauseSheet.classList.add('hidden');\n sheet.classList.remove('hidden');kicker.textContent='SYSTEM ONLINE';message.textContent='NEON FLIGHT';\n helper.textContent='Tap to flap. Navigate between the purple gates. How far can you get?';\n action.textContent='▶ INITIALIZE RUN';subtext.textContent='TAP SCREEN OR PRESS SPACE TO FLY';scoreline.style.display='none';clear();updateHud();}\nfunction openSettings(){\n if(overlay==='settings')return;\n if(mode==='playing'){mode='paused';pauseSheet.classList.add('hidden')}\n overlay='settings';settingsSheet.classList.remove('hidden');updateHud();syncSettings();\n}\nfunction closeSettings(){settingsSheet.classList.add('hidden');overlay='none';\n if(mode==='paused'){pauseSheet.classList.remove('hidden');overlay='pause'}updateHud();}\n\nlet W=390,H=750,dpr=1,frame=0,last=0,mode='ready',score=0,best=0,pipeClock=0;\nlet bird={x:98,y:330,r:14,vy:0,tilt:0},pipes=[],sparks=[],rain=[];\nconst ground=64;\ntry{best=Math.max(0,Number(localStorage.getItem('matrixFlapBest'))||0)}catch(_){}\nbestEl.textContent=String(best).padStart(2,'0');\nconst rand=(a,b)=>a+Math.random()*(b-a);\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nfunction resize(){\n const bounds=canvas.getBoundingClientRect();const oldH=H;\n W=Math.max(250,bounds.width||390);H=Math.max(380,bounds.height||750);\n dpr=Math.min(window.devicePixelRatio||1,perfQuality);\n canvas.width=Math.round(W*dpr);canvas.height=Math.round(H*dpr);\n ctx.setTransform(dpr,0,0,dpr,0,0);\n bird.x=W*.285;bird.r=clamp(W*.051,16,23);\n if(mode==='ready')bird.y=H*.46;\n else bird.y=clamp(bird.y+(H-oldH)*.25,72,H-ground-bird.r);\n rain=Array.from({length:Math.floor(W/19)+2},(_,i)=>({x:i*19+rand(-6,6),y:rand(-H,H),speed:rand(.6,2.25),chars:Math.floor(rand(5,18)),alpha:rand(.09,.38),kind:i%4===0?'green':'purple'}));\n}\nfunction writeScore(){scoreEl.textContent=String(score).padStart(2,'0');bestEl.textContent=String(best).padStart(2,'0')}\nfunction clear(){score=0;passes=0;runSeconds=0;pipeClock=48;pipes=[];sparks=[];bird={x:W*.285,y:H*.46,r:clamp(W*.051,16,23),vy:0,tilt:0};writeScore()}\nfunction start(){clear();mode='playing';overlay='none';settingsSheet.classList.add('hidden');pauseSheet.classList.add('hidden');sheet.classList.add('hidden');last=0;updateHud();playTone(720,.09);flap()}\nfunction flap(){if(mode!=='playing')return;bird.vy=-5.35;bird.tilt=-.48;shipPulse=1;\n playTone(280,.055,'triangle',.035);\n if(settings.effects)for(let i=0;i<9;i++)sparks.push({x:bird.x-bird.r,y:bird.y+rand(-8,8),vx:rand(-3.2,-.5),vy:rand(-2,2),life:rand(15,29),max:29})}\nfunction onInteract(){if(overlay!=='none'||mode==='paused')return;if(mode==='ready'||mode==='over')start();else flap()}\nfunction end(){if(mode!=='playing')return;mode='over';if(score>best){best=score;try{localStorage.setItem('matrixFlapBest',String(best))}catch(_){}}writeScore();\n flash.style.opacity='.14';setTimeout(()=>flash.style.opacity='0',85);playTone(150,.28,'sawtooth',.07);updateHud();\n kicker.textContent='CONNECTION TERMINATED';message.textContent='SIGNAL LOST';helper.textContent='One collision. One more chance. Dodge the gates and beat your record.';\n action.textContent='↻ RESTART MISSION';subtext.textContent='TAP TO REBOOT';scoreline.style.display='block';finalscore.textContent=String(score);\n sheet.classList.remove('hidden');vibrate(45)\n}\nfunction spawnPipe(){const gap=clamp(H*.29,175,222)-Math.min(score*1.2,22);const roof=136;const floor=H-ground-28;\n const center=rand(roof+gap/2+16,Math.max(roof+gap/2+17,floor-gap/2-16));\n pipes.push({x:W+38,w:clamp(W*.18,62,80),center,gap,passed:false,code:Math.floor(rand(100,999))})}\nfunction step(delta){frame+=delta;viewTime+=delta;shipPulse=Math.max(0,shipPulse-delta*.042);\n for(const c of rain){c.y+=c.speed*delta*(reduceMotion?.35:1);if(c.y>H+180)c.y=-rand(60,330)}\n sparks=sparks.filter(s=>s.life>0);for(const s of sparks){s.x+=s.vx*delta;s.y+=s.vy*delta;s.life-=delta}\n if(mode==='ready'){bird.y=H*.46+Math.sin(frame*.045)*8;bird.tilt=Math.sin(frame*.034)*.14;return}\n if(mode!=='playing')return;\n runSeconds+=delta/60;bird.vy=clamp(bird.vy+.30*delta,-7,7);bird.y+=bird.vy*delta;bird.tilt=clamp(bird.vy/9,-.5,1.1);\n pipeClock+=delta;if(pipeClock>=108){spawnPipe();pipeClock-=108}\n const speed=Math.min(3.9,2.55+score*.045);\n for(const p of pipes){p.x-=speed*delta;\n  if(!p.passed&&p.x+p.w<bird.x-bird.r){p.passed=true;score++;passes++;playTone(900,.10,'triangle',.07);vibrate(12);updateHud();if(score>best){best=score;try{localStorage.setItem('matrixFlapBest',String(best))}catch(_){}}writeScore();for(let i=0;i<(settings.effects?13:0);i++)sparks.push({x:bird.x+6,y:bird.y,vx:rand(-3,2),vy:rand(-3,3),life:rand(10,27),max:27})}\n  const left=p.x-6,right=p.x+p.w+6,top=p.center-p.gap/2,bottom=p.center+p.gap/2;\n  const overlap=bird.x+bird.r>left&&bird.x-bird.r<right;\n  if(overlap&&(bird.y-bird.r<top||bird.y+bird.r>bottom)){end();break}\n }\n pipes=pipes.filter(p=>p.x+p.w>-30);\n if(bird.y-bird.r<80||bird.y+bird.r>=H-ground)end();\n}\nfunction hex(col,alpha){ctx.fillStyle=col;ctx.globalAlpha=alpha}\nfunction drawBackground(){\n const gradient=ctx.createLinearGradient(0,0,0,H);gradient.addColorStop(0,'#061423');gradient.addColorStop(.7,'#050916');gradient.addColorStop(1,'#02090c');ctx.fillStyle=gradient;ctx.fillRect(0,0,W,H);\n ctx.save();ctx.strokeStyle='#1c6d4e';ctx.lineWidth=1;ctx.globalAlpha=.14;\n for(let x=(frame*.20)%32-32;x<W;x+=32){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke()}\n for(let y=0;y<H;y+=32){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}\n ctx.restore();\n // Deep neon skyline and distant data spires: all procedural, no asset downloads.\n const skyline=H*.73;\n ctx.save();ctx.globalAlpha=.45;\n for(let layer=0;layer<2;layer++){\n  const unit=layer?53:72,offset=(frame*(layer?.16:.07))%unit;\n  for(let i=-1;i<Math.ceil(W/unit)+2;i++){\n   const x=i*unit-offset,level=(((i*37+17+layer*39)%7+7)%7),ht=(layer?42:70)+level*(layer?16:23);\n   ctx.fillStyle=layer?'#0c2839':'#0a1735';ctx.fillRect(x,skyline-ht,unit-5,ht+ground);\n   ctx.fillStyle=layer?'#2c8f84':'#8553c4';ctx.globalAlpha=layer?.25:.20;\n   for(let yy=skyline-ht+11;yy<skyline-10;yy+=13)ctx.fillRect(x+9,yy,3,4);\n   ctx.globalAlpha=.45;\n  }\n }\n ctx.restore();\n // Perspective floor grid / horizon glow emphasize depth without distracting from gates.\n ctx.save();ctx.strokeStyle='#329e8c';ctx.globalAlpha=.25;ctx.lineWidth=1;\n const horizon=H*.74;\n for(let n=-5;n<=5;n++){\n  ctx.beginPath();ctx.moveTo(W*.5+n*13,horizon);ctx.lineTo(W*.5+n*W*.32,H-ground);ctx.stroke();\n }\n for(let k=0;k<6;k++){\n  let p=k/6;let y=horizon+(H-ground-horizon)*p*p;\n  ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();\n }\n ctx.restore();\n ctx.font='13px ui-monospace,Consolas,monospace';ctx.textAlign='center';ctx.textBaseline='top';\n for(const c of rain){ctx.fillStyle=c.kind==='green'?'#54ff8e':'#ab56ff';\n  for(let i=0;i<Math.min(c.chars,settings.effects?6:2);i++){const y=c.y-i*17;if(y<0||y>H)continue;ctx.globalAlpha=c.alpha*(1-i/c.chars)*.9;ctx.fillText(((Math.floor(c.x*7+i*13+frame*.14)%2)===0?'0':'1'),c.x,y)}\n }\n ctx.globalAlpha=1;\n const halo=ctx.createRadialGradient(W*.5,H*.42,30,W*.5,H*.42,W*.72);halo.addColorStop(0,'#113f3430');halo.addColorStop(1,'#00000000');ctx.fillStyle=halo;ctx.fillRect(0,0,W,H);\n}\nfunction drawPipes(){for(const p of pipes){const top=p.center-p.gap/2,bottom=p.center+p.gap/2;\n   pipeBlock(p.x,0,p.w,top,true);pipeBlock(p.x,bottom,p.w,H-ground-bottom,false);\n}}\nfunction pipeBlock(x,y,w,h,isTop){if(h<=0)return;\n ctx.save();ctx.shadowColor='#a155ff';ctx.shadowBlur=16;const gradient=ctx.createLinearGradient(x,0,x+w,0);\n gradient.addColorStop(0,'#270d49');gradient.addColorStop(.14,'#8947d1');gradient.addColorStop(.48,'#32145b');gradient.addColorStop(.8,'#6129ac');gradient.addColorStop(1,'#281347');\n ctx.fillStyle=gradient;ctx.fillRect(x,y,w,h);ctx.shadowBlur=0;\n ctx.strokeStyle='#bc80ff';ctx.lineWidth=2;ctx.strokeRect(x+.5,y+.5,w-1,h-1);\n ctx.strokeStyle='#dcacff55';ctx.lineWidth=1;\n for(let yy=y+12;yy<y+h-10;yy+=29){ctx.beginPath();ctx.moveTo(x+7,yy);ctx.lineTo(x+w-7,yy);ctx.stroke()}\n const edgeY=isTop?y+h-18:y;\n ctx.shadowColor='#b369ff';ctx.shadowBlur=18;ctx.fillStyle='#401575';ctx.fillRect(x-6,edgeY,w+12,18);ctx.strokeStyle='#d6a0ff';ctx.lineWidth=2;ctx.strokeRect(x-6,edgeY,w+12,18);\n ctx.shadowBlur=0;ctx.fillStyle='#f5cbff';ctx.fillRect(x,edgeY+3,w,2);\n  ctx.strokeStyle='#dff5ff77';ctx.lineWidth=1;\n  for(let d=0;d<4;d++){\n   const fx=x+9+d*(w-18)/3,fy=isTop?edgeY-16:edgeY+26;\n   if(fy>y+5&&fy<y+h-5){ctx.strokeRect(fx,fy,5,5)}\n  }\n  ctx.font='bold 9px ui-monospace,monospace';ctx.fillStyle='#d9b2ff';ctx.textAlign='center';\n  if(h>75)ctx.fillText('GATE',x+w/2,isTop?edgeY-28:edgeY+43);\n  ctx.restore();\n}\nfunction drawGround(){\n const y=H-ground;ctx.save();ctx.shadowBlur=16;ctx.shadowColor='#00ff76';ctx.fillStyle='#0b211d';ctx.fillRect(0,y,W,ground);ctx.fillStyle='#55ff99';ctx.fillRect(0,y,W,2);ctx.shadowBlur=0;\n ctx.strokeStyle='#1a6b4c';ctx.globalAlpha=.65;\n for(let x=(frame*1.5)%40-40;x<W;x+=40){ctx.beginPath();ctx.moveTo(x+30,y+11);ctx.lineTo(x,y+ground);ctx.stroke()}\n ctx.fillStyle='#449167';ctx.globalAlpha=.6;ctx.font='10px ui-monospace,Consolas,monospace';ctx.textAlign='center';ctx.fillText('TRION // SIMULATION ACTIVE',W/2,y+25);ctx.restore();\n}\nfunction drawBird(){\n ctx.save();ctx.translate(bird.x,bird.y);ctx.rotate(bird.tilt);\n const r=bird.r,pulse=.7+shipPulse*.9;\n // Exhaust plume and energetic halo make the player easy to track on phones.\n ctx.save();ctx.globalAlpha=.3+shipPulse*.2;ctx.shadowColor='#33ff9b';ctx.shadowBlur=18;\n ctx.fillStyle='#13f1a2';ctx.beginPath();ctx.moveTo(-r*.9,-r*.22);ctx.lineTo(-r*(1.75+shipPulse),0);\n ctx.lineTo(-r*.9,r*.22);ctx.fill();ctx.restore();\n ctx.shadowColor='#32ffaf';ctx.shadowBlur=settings.effects?9:4;\n const body=ctx.createRadialGradient(-r*.35,-r*.45,2,0,0,r*1.3);\n body.addColorStop(0,'#b0ffcd');body.addColorStop(.27,'#2dcf9a');body.addColorStop(.3,'#0b4634');body.addColorStop(1,'#061a24');\n ctx.fillStyle=body;ctx.strokeStyle='#a5ffca';ctx.lineWidth=2.6;\n ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill();ctx.stroke();\n ctx.shadowBlur=4;ctx.fillStyle='#15eb87';\n ctx.beginPath();ctx.moveTo(-r*.1,-r*.18);ctx.lineTo(-r*1.42,-r*.78);ctx.lineTo(-r*.68,r*.18);ctx.lineTo(-r*.1,r*.4);ctx.closePath();ctx.fill();\n ctx.fillStyle='#5bffc0';ctx.beginPath();ctx.moveTo(r*.42,-r*.14);ctx.lineTo(r*1.58,r*.03);ctx.lineTo(r*.45,r*.52);ctx.closePath();ctx.fill();\n ctx.strokeStyle='#f2ffff';ctx.lineWidth=1.8;ctx.beginPath();ctx.moveTo(-r*.52,r*.55);ctx.lineTo(-r*.12,r*.78);ctx.lineTo(r*.25,r*.64);ctx.stroke();\n ctx.fillStyle='#eafff2';ctx.beginPath();ctx.arc(r*.28,-r*.25,r*.23,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#033426';ctx.beginPath();ctx.arc(r*.34,-r*.26,r*.09,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#b5ffdb';ctx.font='bold '+Math.round(r*.55)+'px ui-monospace,monospace';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('01',-r*.13,r*.40);\n ctx.restore();\n}\nfunction drawSparks(){if(!settings.effects)return;ctx.save();for(const s of sparks){ctx.globalAlpha=clamp(s.life/s.max,0,1);ctx.shadowColor='#59ff7e';ctx.shadowBlur=9;ctx.fillStyle=s.vx>0?'#bf69ff':'#55ff8b';ctx.fillRect(s.x,s.y,3,3)}ctx.restore()}\nfunction render(){ctx.clearRect(0,0,W,H);drawBackground();\n if(mode==='ready'){\n  ctx.save();ctx.globalAlpha=.19;pipeBlock(W*.79,0,62,H*.29,true);pipeBlock(W*.79,H*.61,62,H*.39-ground,false);ctx.restore();\n }\n drawPipes();drawSparks();drawBird();drawGround()}\nfunction loop(t){\n const elapsed=t-(last||t),delta=clamp(elapsed/16.6667||1,.05,2);last=t;\n fpsAccumulator+=elapsed;fpsSamples++;\n if(fpsAccumulator>800){\n  averageFps=Math.round(fpsSamples*1000/fpsAccumulator);fpsEl.textContent=averageFps+' FPS';fpsAccumulator=0;fpsSamples=0;\n  lowFpsWindows=(mode==='playing'&&averageFps<46)?lowFpsWindows+1:0;\n  if(lowFpsWindows>=3&&perfQuality>1.12){perfQuality=Math.max(1.12,perfQuality-.2);lowFpsWindows=0;resize()}\n }\n step(delta);render();requestAnimationFrame(loop)\n}\ncanvas.addEventListener('pointerdown',e=>{e.preventDefault();onInteract()},{passive:false});\naction.addEventListener('click',e=>{e.stopPropagation();start()});\nfor(const b of [settingsBtn,menuSettings])b.addEventListener('click',e=>{e.stopPropagation();openSettings()});\ndocument.getElementById('closeSettings').addEventListener('click',e=>{e.stopPropagation();closeSettings()});\npauseBtn.addEventListener('click',e=>{e.stopPropagation();pause()});\ndocument.getElementById('resumeBtn').addEventListener('click',e=>{e.stopPropagation();resume()});\ndocument.getElementById('restartBtn').addEventListener('click',e=>{e.stopPropagation();start()});\ndocument.getElementById('homeBtn').addEventListener('click',e=>{e.stopPropagation();home()});\nfor(const [key,button] of Object.entries(settingsButtons))button.addEventListener('click',e=>{e.stopPropagation();settings[key]=!settings[key];syncSettings();playTone(600,.05)});\nwindow.matrixFlapBack=()=>{if(overlay==='settings'){closeSettings();return true}if(mode==='paused'){resume();return true}if(mode==='playing'){pause();return true}return false};\n\nwindow.addEventListener('keydown',e=>{\n if(e.code==='Escape'||e.code==='KeyP'){e.preventDefault();window.matrixFlapBack();return}\n if(e.code==='Space'||e.code==='ArrowUp'){e.preventDefault();if(!e.repeat)onInteract()}\n});\nwindow.addEventListener('resize',resize);\nwindow.addEventListener('blur',()=>{last=0});\ndocument.addEventListener('visibilitychange',()=>{last=0;if(document.hidden&&mode==='playing')pause()});\nresize();clear();syncSettings();updateHud();requestAnimationFrame(loop);\n// Intentionally expose small, read-only inspection surface for runtime diagnostics.\nwindow.matrixFlapStatus=()=>({state:mode,score,best,pipes:pipes.length,\n birdY:Math.round(bird.y),birdR:bird.r,runSeconds:Math.round(runSeconds*10)/10,\n fps:averageFps,settings:{...settings},overlay,passes,width:W,height:H,pixelRatio:dpr,\n birdVy:+bird.vy.toFixed(2),nearestGate:pipes.length?{x:Math.round(pipes[0].x),center:Math.round(pipes[0].center),gap:Math.round(pipes[0].gap)}:null,version:'1.1'});\n})();\n</script>\n</body>\n</html>"
