);syncSettings();updateHud();requestAnimationFrame(loop);\n// Intentionally expose small, read-only inspection surface for runtime diagnostics.\nwindow.matrixFlapStatus=()=>({state:mode,score,best,pipes:pipes.length,\n birdY:Math.round(bird.y),birdR:bird.r,runSeconds:Math.round(runSeconds*10)/10,\n fps:averageFps,settings:{...settings},overlay,passes,width:W,height:H,pixelRatio:dpr,\n birdVy:+bird.vy.toFixed(2),nearestGate:pipes.length?{x:Math.round(pipes[0].x),center:Math.round(pipes[0].center),gap:Math.round(pipes[0].gap)}:null,version:'1.2'});\n})();\n</script>\n</body>\n</html>"
